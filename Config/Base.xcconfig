// Shared build settings for every contributor.
// Default signing is ad-hoc ("Sign to Run Locally"), so a fresh clone builds and runs
// with no Apple developer account. To sign with your team, copy Local.xcconfig.example
// to Local.xcconfig (git-ignored) and fill it in.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.jxngrx.jerox

#include? "Local.xcconfig"
